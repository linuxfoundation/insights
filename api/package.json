{
  "name": "@lfx-insights/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "tsc-check": "tsc --noEmit",
    "test": "vitest run",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "docs:dev": "pnpm openapi:export docs/site/public/openapi && vitepress dev docs/site",
    "docs:build": "pnpm openapi:export docs/site/public/openapi && vitepress build docs/site",
    "docs:preview": "vitepress preview docs/site"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@lfx-insights/postgres-client": "workspace:*",
    "@lfx-insights/tinybird-client": "workspace:*",
    "@lfx-insights/types": "workspace:*",
    "@redis/client": "^6.2.1",
    "@sinclair/typebox": "^0.34.0",
    "dd-trace": "^6.20.1",
    "fastify": "^5.12.6",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@scalar/api-reference": "^1.68.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  }
}
