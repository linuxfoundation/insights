{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insights-api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": { "enabled": true },
  "vars": { "ORIGIN_URL": "http://insights-api-svc.insights.svc.cluster.local:4000" },
  "vpc_services": [
    { "binding": "INSIGHTS_API", "service_id": "01a0ecc6-aa1b-7203-b84b-565a8f05a177" },
  ],
}
